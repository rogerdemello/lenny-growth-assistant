# =============================================================================
# The Lenny Growth Assistant — environment configuration
#
# Copy to `.env` and fill in. Every value here has a safe default except
# DATABASE_URL, which you must supply.
#
#   cp .env.example .env
#
# The whole point of this file: switching the model an evaluator runs against
# should never require touching application code.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — database
# -----------------------------------------------------------------------------
# PostgreSQL with the pgvector extension. Supabase, Railway, or local Postgres.
#
# Supabase note: the free tier's pooled connection string uses port 6543 in
# transaction mode, which breaks asyncpg's prepared-statement cache. The app
# disables that cache automatically when it sees port 6543 — you do not need to
# do anything, but that is why you may see `statement_cache_size=0` in logs.
DATABASE_URL=postgresql://postgres:password@localhost:5432/lenny

# -----------------------------------------------------------------------------
# MODEL SELECTION — the toggle
# -----------------------------------------------------------------------------
# Which provider answers chat turns. One of: ollama | azure | openai_compat
# `ollama` is the default and requires no API key.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# Provider to retry on when the primary times out or errors. Leave blank to
# disable fallback. The response reports which provider actually answered.
LLM_FALLBACK_PROVIDER=

# Which provider generates Ship 30 essays.
#
# Defaults to `azure` because long-form is where a 3B local model struggles
# most. Measured on the same topic:
#
#   ollama llama3.2  8-12 min   857 words   7/9 validator checks
#   azure  gpt-4o      37 sec  1226 words   9/9 validator checks
#
# **This falls back to LLM_PROVIDER automatically if the named provider has no
# credentials**, so leaving it as `azure` with no Azure key configured simply
# runs essays locally. Set it to `ollama` to force fully-offline operation.
#
# Everything else — chat, retrieval, citations, refusal, artifacts — runs on
# LLM_PROVIDER regardless.
ESSAY_PROVIDER=azure

# Which agent runtime executes tools. One of: local | claude_sdk
# `local` runs a deterministic tool loop against any OpenAI-compatible endpoint.
# `claude_sdk` uses the Anthropic Claude Agent SDK and needs either
# ANTHROPIC_API_KEY or an Anthropic-Messages-format gateway (see below).
AGENT_RUNTIME=local

# -----------------------------------------------------------------------------
# OLLAMA (local, default — no key required)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# AZURE OPENAI (cloud)
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# -----------------------------------------------------------------------------
# GENERIC OPENAI-COMPATIBLE (NVIDIA NIM, OpenAI, Groq, vLLM, ...)
# -----------------------------------------------------------------------------
OPENAI_COMPAT_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=meta/llama-3.3-70b-instruct

# -----------------------------------------------------------------------------
# ANTHROPIC / CLAUDE AGENT SDK (optional)
# -----------------------------------------------------------------------------
# Set ANTHROPIC_API_KEY and AGENT_RUNTIME=claude_sdk to run the Claude Agent SDK
# runtime directly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# No Anthropic key? The SDK runtime also runs against Azure OpenAI through the
# bundled Anthropic-Messages gateway. This path is verified working — see
# gateway/README.md.
#
#   uv pip install -e ".[agent-sdk,gateway]"
#   ./scripts/start-gateway.ps1
#
# then uncomment these and set AGENT_RUNTIME=claude_sdk above:
# ANTHROPIC_BASE_URL=http://127.0.0.1:4000
# ANTHROPIC_AUTH_TOKEN=sk-gateway-local-only
# ANTHROPIC_MODEL=claude-azure-gpt4o

# -----------------------------------------------------------------------------
# EMBEDDINGS
# -----------------------------------------------------------------------------
# Which provider produces vectors. One of: ollama | azure | openai_compat
# Changing this after ingestion requires a re-index — vector dimensions differ.
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Asymmetric-retrieval task prefixes. nomic-embed-text is TRAINED with these and
# expects them at inference; omitting them measurably degrades score calibration.
# Defaults are inferred from EMBED_MODEL, so leave these blank unless you are
# using a model this project does not know about. Blank means "use the default";
# to force no prefix on a model that would otherwise get one, set them to a
# single space.
# EMBED_QUERY_PREFIX=search_query:·
# EMBED_DOCUMENT_PREFIX=search_document:·

# -----------------------------------------------------------------------------
# RETRIEVAL
# -----------------------------------------------------------------------------
# How many passages to retrieve and show as citations.
RETRIEVAL_TOP_K=8
# How many of those actually enter the prompt. Kept lower than TOP_K on purpose:
# on CPU, prefill dominates latency. Measured on a Ryzen 7 7730U, 8 chunks cost
# ~22s to first token versus ~11s for 4. Raise it if you run on a cloud provider.
PROMPT_TOP_K=4
# Cosine similarity below this is treated as "the transcripts do not cover this"
# rather than answered anyway. Raise it to make the assistant more cautious.
#
# This value is MODEL-SPECIFIC and must be calibrated, not guessed. An initial
# 0.35 let an out-of-domain question ("best kubernetes ingress controller",
# scoring 0.44) through as if it were grounded — the exact failure the floor
# exists to prevent. Re-calibrate whenever you change EMBED_MODEL:
#
#   python -m app.rag.calibrate
RETRIEVAL_SCORE_FLOOR=0.55

# -----------------------------------------------------------------------------
# INGESTION
# -----------------------------------------------------------------------------
TRANSCRIPTS_REPO=ChatPRD/lennys-podcast-transcripts
TRANSCRIPTS_REF=main
# Episodes shorter than this are YouTube shorts, not interviews. They are
# citation-poor and hurt retrieval precision.
INGEST_MIN_DURATION_SECONDS=1800
# Cap the corpus. Full ingest of all 269 episodes takes 1-2h on CPU.
INGEST_MAX_EPISODES=40
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
# Guards POST /api/ingest. Leave blank to disable the endpoint entirely.
INGEST_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# `json` for machine-readable structured logs, `console` for human-readable dev.
LOG_FORMAT=console
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_TIMEOUT_SECONDS=180

# -----------------------------------------------------------------------------
# FRONTEND (Vite — must be prefixed VITE_)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
